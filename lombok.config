# Tell Lombok to also copy Spring's @Qualifier (and a few common JSR-380 / Jakarta validation
# annotations) from fields to the auto-generated constructor parameters when using
# @RequiredArgsConstructor / @AllArgsConstructor.
#
# Without this, fields like:
#   @Qualifier("commonExecutor") private final ThreadPoolTaskExecutor executor;
# will still inject by-type and fail when multiple beans of the same type exist.
config.stopBubbling = true

lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += jakarta.validation.constraints.NotNull
lombok.copyableAnnotations += jakarta.validation.constraints.NotBlank
lombok.copyableAnnotations += jakarta.validation.constraints.NotEmpty
