# ZWSK Chat environment template
# Copy to .env only on the deployment host. Never commit real secrets.

SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Public domain, used by deployment preflight and operators. Nginx/SLB still owns HTTPS.
PUBLIC_DOMAIN=

# JWT: production must use at least 64 random characters.
JWT_SECRET=CHANGE_ME_GENERATE_64_PLUS_RANDOM_CHARS
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=604800

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=zwskchat
MYSQL_USER=zwsk
MYSQL_PASSWORD=CHANGE_ME_RANDOM
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT
MYSQL_SSL=false
DB_POOL_MAX=30
DB_POOL_MIN_IDLE=8

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_RANDOM
REDIS_DB=0

# RabbitMQ
RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
RABBIT_USER=zwsk
RABBIT_PASSWORD=CHANGE_ME_RANDOM
RABBIT_VHOST=/
RABBIT_LISTENER_AUTO_STARTUP=true

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=CHANGE_ME_RANDOM
QDRANT_COLLECTION_PREFIX=zwsk_kb

# MinIO / object storage
MINIO_ENABLED=true
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_RANDOM
MINIO_SECRET_KEY=CHANGE_ME_RANDOM
MINIO_BUCKET=zwsk-kb

# DashScope / Bailian
DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
DASHSCOPE_REGION=china

# AI defaults
AI_CHAT_PROVIDER=dashscope-sdk
AI_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBED_PROVIDER=dashscope-sdk
AI_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBED_MODEL=text-embedding-v3
AI_EMBED_DIMENSION=1024

# Voice
VOICE_ASR_PROVIDER=dashscope-paraformer
VOICE_TTS_PROVIDER=dashscope-cosyvoice
JARVIS_PUBLIC_ENABLED=false

# Bootstrap
ZWSK_BOOTSTRAP_RESET_ADMIN_PASSWORD=false
ZWSK_BOOTSTRAP_ADMIN_DEFAULT_PASSWORD=

# CORS. For same-origin Nginx deployment this can stay empty.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

# Vite dev server. Keep empty for localhost-only defaults.
# Use "*" only for temporary tunnel testing; prefer explicit hosts when possible.
VITE_DEV_ALLOWED_HOSTS=
